# Copy to .env; keep actual credentials outside Git.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional vision-capable provider / model for screenshot analysis.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Optional remote screenshot service.
# BROWSERLESS_TOKEN=
# Run npm run create-access, then paste its output into .env locally.
DESIGN_EVALS_BETA_CODES=[]
DESIGN_EVALS_SESSION_SECRET=
# Optional private Vercel Blob store for email requests.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
PORT=4317
